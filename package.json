{
  "name": "get-source-code",
  "productName": "GetSourceCode",
  "version": "1.1.1",
  "description": "一键获取目标网站的源代码、网络数据包(HAR)与媒体资源的可视化工具（基于 Chrome DevTools Protocol）",
  "main": "src/main/main.js",
  "author": "lza6",
  "license": "MIT",
  "keywords": [
    "cdp",
    "chrome-devtools-protocol",
    "scraper",
    "har",
    "website-source",
    "reverse-engineering",
    "network-capture"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/generate-icon.js",
    "prebuild": "node scripts/generate-icon.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --dir",
    "test": "node test/test.js",
    "test:e2e": "node test/test.js && node test/e2e-login.js",
    "test:login": "node test/e2e-login.js",
    "test:combo": "node test/e2e-combo.js",
    "bench": "node test/bench.js 3",
    "bench:5": "node test/bench.js 5",
    "soak": "node test/soak.js 8",
    "capture": "node test/run-capture.js",
    "postinstall": "electron-builder install-app-deps",
    "test:edge": "node test/edge-cases.js",
    "capture:multi": "node test/run-multi.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lza6.getsourcecode",
    "productName": "GetSourceCode",
    "copyright": "Copyright © 2026 lza6",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GetSourceCode"
    },
    "portable": {
      "artifactName": "GetSourceCode-${version}-portable.exe"
    }
  }
}
